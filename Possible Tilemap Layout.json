{
	//Would have the tilemap definitons first:
	"tilemap-size-x":10, //u16
	"tilemap-size-y":10, //u16
	"tile-size-px":16, //u16
	"chunk-count":2, //u8 split x&y into seperate files, for ram optimization
	"layer-count":2, //u8
	//Then we define each of the tiles, they will have their own autogenerated id starting at 1, 0 will be a null tile.
	"tiles": [
		{
			"texture-path":"idk/whatever.png",
			"collision-path":"idk/whatever.oxcl",
			"collision":true,
			"animated":true,
			"animation":{
				"fps":10,
				"frames":2,
				"animation-layout":"horiz,vert, or grid"
			},
		}
	],

	//Then we list the layer data
	"layer-heights": [-1,1] //i8 array
	
	
}