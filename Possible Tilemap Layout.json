{
	//Would have the tilemap definitons first:
	"tilemap-size-x":10, //u16
	"tilemap-size-y":10, //u16
	"tile-size-px":16, //u16
	"chunk-count-x":2, //u8 split map into seperate files, for ram optimization. this is a divisor of tilemap-size. tilemap-size-x MUST be evenly divisable by this for this to be valid data.
	"chunk-count-y":2, //u8 split map into seperate files, for ram optimization. this is a divisor of tilemap-size. tilemap-size-y MUST be evenly divisable by this for this to be valid data.
	//chunks will be generated around the player, default pregeneration is a 1 chunk off screen border in all directions will be loaded at any given time

	//Then we define each of the tiles, they will have their own autogenerated u16 id starting at 1 (id=index+1). 0 will always be a null/empty tile with no collision.
	"tiles": [ //At most u16-1 tiles.
		{
			"texture-path":"idk/whatever.png",
			"collision-path":"idk/whatever.oxcl",
			"collision":true,
			"animated":true,
			"animation":{
				"fps":10, //u8
				"frames":2, //u8
				"animation-layout":"horiz,vert, or grid"
			},
			"texture-rotation":0, //u8 90 degree increments
			"texture-offset-x":5, //u16 in px
			"texture-offset-y":5, //u16 in px
		}
	],


	//then the layers:
	"layers": [ //AT MOST u8 LAYERS
		{
			"type":"terrain-collision, overlay", //overlay will not have any form of collision. this matters for tile count optimization, as well as reduce files for later compile-time chunk collision poly merging.
			"height":-1, //i8 render priority over other layers. if matching other layers in this array it will be based on index.
		}
	]
}